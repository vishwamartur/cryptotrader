# AI Trading Platform Performance Configuration
# Copy this file to .env.local and configure your values

# ============================================================================
# AI SERVICE CONFIGURATION
# ============================================================================
# Required for AI-powered trading analysis (get from https://www.perplexity.ai/settings/api)
PERPLEXITY_API_KEY=pplx-your-api-key-here

# AI Performance Optimization
AI_REQUEST_TIMEOUT=1000
AI_CACHE_TTL=60
AI_CONCURRENT_LIMIT=5
AI_CACHE_ENABLED=true
AI_CACHE_MAX_ENTRIES=1000

# ============================================================================
# TRADING EXCHANGE API
# ============================================================================
# Required for live trading (get from https://www.delta.exchange/app/api-management)
DELTA_EXCHANGE_API_KEY=your_delta_exchange_api_key_here
DELTA_EXCHANGE_API_SECRET=your_delta_exchange_api_secret_here

# Exchange WebSocket Configuration
DELTA_WS_URL=wss://socket.india.delta.exchange
DELTA_WS_RECONNECT_INTERVAL=5000
DELTA_WS_MAX_RECONNECT_ATTEMPTS=10

# ============================================================================
# CACHING CONFIGURATION
# ============================================================================
# Redis Configuration (for distributed caching)
REDIS_URL=redis://localhost:6379
REDIS_POOL_SIZE=10
REDIS_CLUSTER_NODES=localhost:6379

# Cache Performance Settings
CACHE_TTL_DEFAULT=300
CACHE_TTL_MARKET_DATA=60
CACHE_TTL_AI_ANALYSIS=300
CACHE_TTL_ML_PREDICTIONS=600

# Cache Optimization
CACHE_COMPRESSION_ENABLED=true
CACHE_MAX_MEMORY_USAGE=512
CACHE_CLEANUP_INTERVAL=300000

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL Database
DATABASE_URL=postgresql://username:password@localhost:5432/cryptotrader
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cryptotrader
DB_USER=username
DB_PASSWORD=password

# Database Performance Optimization
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_QUERY_TIMEOUT=10000
DB_SLOW_QUERY_THRESHOLD=50
DB_CONNECTION_TIMEOUT=5000

# Database Caching
DB_QUERY_CACHE_ENABLED=true
DB_RESULT_CACHE_TTL=300

# ============================================================================
# WEBSOCKET OPTIMIZATION
# ============================================================================
# WebSocket Performance Settings
WS_MAX_CONNECTIONS=10000
WS_MESSAGE_BATCH_SIZE=100
WS_HEARTBEAT_INTERVAL=30000
WS_COMPRESSION_THRESHOLD=1024
WS_ENABLE_COMPRESSION=true
WS_ENABLE_BINARY_PROTOCOL=true

# WebSocket Load Balancing
WS_LOAD_BALANCER_ENABLED=true
WS_CONNECTION_HEALTH_CHECK=true
WS_RECONNECT_BACKOFF_MS=1000
WS_MAX_RECONNECT_ATTEMPTS=5

# ============================================================================
# API PERFORMANCE MIDDLEWARE
# ============================================================================
# Rate Limiting
API_RATE_LIMIT=100
API_RATE_LIMIT_ANONYMOUS=20
API_RATE_LIMIT_PREMIUM=500
API_RATE_LIMIT_WINDOW=60000

# Request Optimization
API_MAX_REQUEST_SIZE=10485760
API_REQUEST_TIMEOUT=30000
API_ENABLE_DEDUPLICATION=true
API_ENABLE_RESPONSE_COMPRESSION=true

# API Caching
API_CACHE_ENABLED=true
API_CACHE_TTL_DEFAULT=300
API_CACHE_MAX_SIZE=10000

# ============================================================================
# HIGH-FREQUENCY TRADING (HFT) ENGINE
# ============================================================================
# HFT Performance Targets
HFT_MAX_TICKS_PER_SECOND=10000
HFT_TARGET_LATENCY=0.5
HFT_BATCH_SIZE=10
HFT_BATCH_TIMEOUT=5

# HFT Memory Optimization
HFT_MEMORY_POOL_SIZE=1000
HFT_CIRCULAR_BUFFER_SIZE=10000
HFT_ENABLE_TYPED_ARRAYS=true
HFT_ENABLE_OBJECT_POOLING=true

# ============================================================================
# MACHINE LEARNING OPTIMIZATION
# ============================================================================
# ML Performance Settings
ML_BATCH_SIZE=32
ML_EPOCHS=50
ML_LEARNING_RATE=0.001
ML_EARLY_STOPPING_PATIENCE=5
ML_MAX_TRAINING_TIME=300000

# ML Hardware Acceleration
ML_ENABLE_GPU=true
ML_ENABLE_WEB_WORKER=false
ML_ENABLE_QUANTIZATION=true

# ML Memory Management
ML_MEMORY_LIMIT=2147483648
ML_MODEL_CACHE_SIZE=5
ML_INFERENCE_TIMEOUT=1000

# ============================================================================
# PERFORMANCE MONITORING
# ============================================================================
# Monitoring Configuration
MONITORING_ENABLED=true
MONITORING_INTERVAL=5000
MONITORING_ALERT_COOLDOWN=300
MONITORING_METRICS_RETENTION=86400000

# Alert Thresholds
ALERT_CPU_THRESHOLD=80
ALERT_MEMORY_THRESHOLD=85
ALERT_LATENCY_THRESHOLD=1000
ALERT_ERROR_RATE_THRESHOLD=5
ALERT_THROUGHPUT_THRESHOLD=10

# Alert Channels (configure as needed)
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
ALERT_EMAIL_SMTP_HOST=smtp.gmail.com
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_USER=your-email@example.com
ALERT_EMAIL_PASSWORD=your-app-password

# ============================================================================
# NODE.JS PERFORMANCE
# ============================================================================
# Node.js Optimization
NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=4096
UV_THREADPOOL_SIZE=16

# Garbage Collection
NODE_GC_INTERVAL=300000
NODE_HEAP_SIZE_LIMIT=2147483648

# ============================================================================
# FRONTEND PERFORMANCE
# ============================================================================
# Client-side Optimization
NEXT_PUBLIC_WS_URL=wss://your-domain.com/ws
NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.com
NEXT_PUBLIC_ENABLE_PERFORMANCE_MONITORING=true

# Frontend Caching
NEXT_PUBLIC_CACHE_VERSION=1.0.0
NEXT_PUBLIC_ENABLE_SERVICE_WORKER=true
NEXT_PUBLIC_OFFLINE_SUPPORT=true

# ============================================================================
# PRODUCTION DEPLOYMENT
# ============================================================================
# Server Configuration
PORT=3000
HOST=0.0.0.0
WORKER_PROCESSES=4

# Security
CORS_ORIGIN=https://your-domain.com
RATE_LIMIT_STRICT=true
ENABLE_HELMET_SECURITY=true
ENABLE_API_AUTHENTICATION=true

# SSL/HTTPS
SSL_CERT_PATH=/path/to/cert.pem
SSL_KEY_PATH=/path/to/key.pem
FORCE_HTTPS=true

# ============================================================================
# LOGGING AND DEBUGGING
# ============================================================================
# Log Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs/app.log

# Debug Mode (disable in production)
DEBUG=false
VERBOSE_LOGGING=false
ENABLE_PERFORMANCE_LOGS=true

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# Performance Features
ENABLE_AI_CACHING=true
ENABLE_HFT_OPTIMIZATION=true
ENABLE_ML_QUANTIZATION=true
ENABLE_WS_COMPRESSION=true
ENABLE_DB_QUERY_CACHE=true

# Beta Features
ENABLE_BETA_FEATURES=false
ENABLE_EXPERIMENTAL_OPTIMIZATIONS=false

# ============================================================================
# DEVELOPMENT & TESTING
# ============================================================================
# Development Settings
NODE_ENV=development
ENABLE_HOT_RELOAD=true
ENABLE_SOURCE_MAPS=true
MOCK_EXTERNAL_APIS=true

# Testing Configuration
TEST_TIMEOUT=30000
TEST_PARALLEL_WORKERS=4
ENABLE_PERFORMANCE_TESTS=true

# ============================================================================
# BACKUP & RECOVERY
# ============================================================================
# Backup Configuration
BACKUP_ENABLED=true
BACKUP_INTERVAL=86400000
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=./backups

# Disaster Recovery
ENABLE_AUTO_RECOVERY=true
RECOVERY_CHECK_INTERVAL=60000
HEALTH_CHECK_ENDPOINT=/health

# ============================================================================
# ANALYTICS & TELEMETRY
# ============================================================================
# Analytics (optional)
ANALYTICS_ENABLED=false
ANALYTICS_PROVIDER=custom
ANALYTICS_API_KEY=your-analytics-key

# Telemetry
TELEMETRY_ENABLED=false
TELEMETRY_ENDPOINT=https://telemetry.example.com
TELEMETRY_INTERVAL=300000